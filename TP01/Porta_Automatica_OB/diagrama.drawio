        <mxCell id="obst" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e8f1fd;strokeColor=#2f5f98;fontColor=#1f2937;fontSize=15;align=center;verticalAlign=middle;spacingLeft=10;spacingTop=4;strokeWidth=1.6;" value="&lt;b&gt;Sensor de obstáculo&lt;br&gt;(barreira no vão)&lt;/b&gt;" vertex="1">
          <mxGeometry height="70" width="200" x="210" y="330" as="geometry" />
        </mxCell>
        <mxCell id="logica" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1e4b7a;strokeColor=#16385c;fontColor=#ffffff;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;strokeWidth=1.6;" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;font color=&quot;#ffffff&quot; style=&quot;font-size: 15px;&quot;&gt;&lt;b&gt;LÓGICA DA PORTA (controlador)&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;font color=&quot;#ffffff&quot; style=&quot;font-size: 13px;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;b style=&quot;color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18)); background-color: transparent;&quot;&gt;R1 · Presença, sem falha → ABRIR&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b style=&quot;color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18)); background-color: transparent;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;/font&gt;&lt;font color=&quot;#ffffff&quot; style=&quot;font-size: 13px;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;b style=&quot;color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18)); background-color: transparent;&quot;&gt;R2 · Aberta, sem presença e vão livre&amp;nbsp;&lt;/b&gt;&lt;b style=&quot;color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18)); background-color: transparent;&quot;&gt;por 3 s → FECHAR&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b style=&quot;color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18)); background-color: transparent;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;/font&gt;&lt;font color=&quot;#ffffff&quot; style=&quot;font-size: 13px;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;b style=&quot;color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18)); background-color: transparent;&quot;&gt;R3 · Obstáculo durante o fechamento&amp;nbsp;&lt;/b&gt;&lt;b style=&quot;color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18)); background-color: transparent;&quot;&gt;→ PARAR e REABRIR&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b style=&quot;color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18)); background-color: transparent;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;/font&gt;&lt;font color=&quot;#ffffff&quot; style=&quot;font-size: 13px;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;b style=&quot;color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18)); background-color: transparent;&quot;&gt;R4 · Posição não muda em 5 s após&amp;nbsp;&lt;/b&gt;&lt;b style=&quot;color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18)); background-color: transparent;&quot;&gt;comando → FALHA: parar e alarmar&lt;/b&gt;&lt;/div&gt;&lt;/font&gt;&lt;font color=&quot;#ffd2d2&quot; style=&quot;font-size: 13px;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;b style=&quot;color: light-dark(rgb(255, 210, 210), rgb(79, 40, 40)); background-color: transparent;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b style=&quot;color: light-dark(rgb(255, 210, 210), rgb(79, 40, 40)); background-color: transparent;&quot;&gt;R5 · Emergência → ABRIR e manter aberta&lt;/b&gt;&lt;/div&gt;&lt;/font&gt;&lt;font color=&quot;#ffd2d2&quot; style=&quot;font-size: 12px;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(255, 210, 210), rgb(79, 40, 40)); background-color: transparent;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; (prioridade sobre R1–R4)&lt;/span&gt;&lt;/div&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="260" width="360" x="490" y="170" as="geometry" />
        </mxCell>
        <mxCell id="sinal" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f1eaf8;strokeColor=#6b4c9a;fontColor=#1f2937;fontSize=15;align=center;verticalAlign=middle;spacingLeft=10;spacingTop=4;strokeWidth=1.6;" value="&lt;b&gt;Sinalizador&lt;br&gt;(luz e alarme)&lt;/b&gt;" vertex="1">
          <mxGeometry height="60" width="220" x="950" y="170" as="geometry" />
        </mxCell>
        <mxCell id="motor" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fdf0d9;strokeColor=#b45309;fontColor=#1f2937;fontSize=15;align=center;verticalAlign=middle;spacingLeft=10;spacingTop=4;strokeWidth=1.6;" value="&lt;b&gt;Motor da porta&lt;/b&gt;" vertex="1">
          <mxGeometry height="70" width="220" x="950" y="280" as="geometry" />
        </mxCell>
        <mxCell id="pos" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e8f1fd;strokeColor=#2f5f98;fontColor=#1f2937;fontSize=15;align=center;verticalAlign=middle;spacingLeft=10;spacingTop=4;strokeWidth=1.6;" value="&lt;b&gt;Sensor de posição&lt;br&gt;(aberta / fechada)&lt;/b&gt;" vertex="1">
          <mxGeometry height="70" width="220" x="950" y="470" as="geometry" />
        </mxCell>
        <mxCell id="falha" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff6cc;strokeColor=#a68a00;fontColor=#1f2937;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;strokeWidth=1.6;" value="&lt;font color=&quot;#7a5b00&quot; style=&quot;font-size:13px&quot;&gt;&lt;b&gt;FALHA (tratada pela R4)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1f2937&quot; style=&quot;font-size:12.5px&quot;&gt;Motor travado ou sensor de posição com&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1f2937&quot; style=&quot;font-size:12.5px&quot;&gt;defeito: a posição não muda em 5 s.&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1f2937&quot; style=&quot;font-size:12.5px&quot;&gt;Resposta: parar o motor, acionar o alarme&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1f2937&quot; style=&quot;font-size:12.5px&quot;&gt;e não fechar automaticamente.&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="360" x="210" y="555" as="geometry" />
        </mxCell>
        <mxCell id="seguro" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf6ee;strokeColor=#2e7d4f;fontColor=#1f2937;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;strokeWidth=1.6;dashed=1;" value="&lt;font color=&quot;#1d5e38&quot; style=&quot;font-size:13px&quot;&gt;&lt;b&gt;ESTADO SEGURO&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1f2937&quot; style=&quot;font-size:12.5px&quot;&gt;Porta ABERTA e parada (passagem livre).&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1f2937&quot; style=&quot;font-size:12.5px&quot;&gt;Sem energia: destrava e abre com a mão.&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1f2937&quot; style=&quot;font-size:12.5px&quot;&gt;Após falha ou emergência, só volta ao&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1f2937&quot; style=&quot;font-size:12.5px&quot;&gt;automático com rearme manual na chave.&lt;/font&gt;" vertex="1">
